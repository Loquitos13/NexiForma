{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NexiFormaStorageObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::nexiforma-storage",
        "arn:aws:s3:::nexiforma-storage/*"
      ]
    },
    {
      "Sid": "NexiFormaStorageKmsOptional",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:eu-west-1:ACCOUNT_ID:key/KEY_ID"
      ]
    }
  ]
}
